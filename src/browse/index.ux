<template>
  <scroll class="page">
    <div class="top-space"></div>
    <text class="title">{{title}}</text>
    <text if="{{subtitle}}" class="subtitle">{{subtitle}}</text>
    <div for="a in actions" class="action" on:click="act(a.key)">
      <text class="action-text">{{a.label}}</text>
    </div>
    <text if="{{emptyText}}" class="empty">{{emptyText}}</text>
    <div for="row in rows" class="slot">
      <div if="{{row.kind === 'folder'}}" class="row" on:click="tap(row.i)">
        <div class="texts">
          <text class="label">{{row.label}}</text>
          <text class="sub">{{row.sub}}</text>
        </div>
        <image class="icon" src="/assets/folder.png"/>
      </div>
      <div if="{{row.kind === 'song' && !row.current}}" class="row" on:click="tap(row.i)">
        <div class="texts">
          <text class="label">{{row.label}}</text>
          <text class="sub">{{row.sub}}</text>
        </div>
        <image class="icon" src="/assets/note-small.png"/>
      </div>
      <div if="{{row.kind === 'song' && row.current}}" class="row row-current" on:click="tap(row.i)">
        <div class="texts">
          <text class="label label-current">{{row.label}}</text>
          <text class="sub sub-current">{{row.sub}}</text>
        </div>
        <image class="icon" src="/assets/play.png"/>
      </div>
      <div if="{{row.kind === 'group' && row.thumb}}" class="row" on:click="tap(row.i)">
        <div class="texts">
          <text class="label">{{row.label}}</text>
          <text class="sub">{{row.sub}}</text>
        </div>
        <image class="thumb" src="{{row.thumb}}"/>
      </div>
      <div if="{{row.kind === 'group' && !row.thumb}}" class="row" on:click="tap(row.i)">
        <div class="texts">
          <text class="label">{{row.label}}</text>
          <text class="sub">{{row.sub}}</text>
        </div>
      </div>
    </div>
    <div if="{{hasMore}}" class="action" on:click="showMore">
      <text class="action-text">{{moreText}}</text>
    </div>
    <div class="bottom-space"></div>
  </scroll>
</template>

<style>
  .page {
    width: 466px;
    height: 466px;
    background-color: #000000;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .top-space {
    width: 10px;
    height: 44px;
  }

  .bottom-space {
    width: 10px;
    height: 100px;
  }

  .title {
    width: 300px;
    font-size: 30px;
    color: #ffa040;
    text-align: center;
    max-lines: 1;
    text-overflow: ellipsis;
  }

  .subtitle {
    width: 300px;
    font-size: 20px;
    color: #8a8aa0;
    text-align: center;
    max-lines: 1;
    text-overflow: ellipsis;
  }

  .action {
    width: 300px;
    height: 62px;
    margin-top: 10px;
    border-radius: 31px;
    background-color: #3a2410;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .action-text {
    font-size: 26px;
    color: #ffc080;
    text-align: center;
  }

  .empty {
    width: 320px;
    margin-top: 30px;
    font-size: 26px;
    color: #b0b0c4;
    text-align: center;
  }

  .slot {
    width: 370px;
    height: 84px;
    margin-top: 8px;
  }

  .row {
    width: 370px;
    height: 84px;
    border-radius: 20px;
    background-color: #16161f;
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 0 14px;
  }

  .row-current {
    background-color: #ffa040;
  }

  .texts {
    flex: 1;
    height: 84px;
    margin-right: 10px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-end;
  }

  .label {
    max-width: 280px;
    font-size: 26px;
    color: #ffffff;
    max-lines: 1;
    text-overflow: ellipsis;
  }

  .sub {
    max-width: 280px;
    font-size: 19px;
    color: #9a9ab0;
    max-lines: 1;
    text-overflow: ellipsis;
  }

  .label-current {
    color: #141420;
  }

  .sub-current {
    color: #3a2410;
  }

  .icon {
    width: 40px;
    height: 40px;
  }

  .thumb {
    width: 60px;
    height: 60px;
    border-radius: 8px;
  }
</style>

<script>
  import prompt from '@system.prompt'
  import router from '@system.router'
  import { boot, takeView, openView, openInput, openPlayer } from '../lib/boot.js'
  import { lib, findFolder, folderTracksDeep, songLine, existing, ROOT } from '../lib/library.js'
  import { st, removeFromPlaylist, deletePlaylist } from '../lib/store.js'
  import { current, subscribe, playQueue, jumpTo, queueInOrder, pl } from '../lib/player.js'
  import { T, countText } from '../lib/strings.js'

  // Rows are rendered in steps, so long lists stay light on the watch.
  const STEP = 30

  function toast(text) {
    try {
      prompt.showToast({ message: text })
    } catch (e) {
      console.info('[music] toast failed: ' + e)
    }
  }

  // Hebrew first, so the line is laid out right to left even with a Latin artist name.
  function trackLine(t) {
    const parts = []
    if (t.track > 0) parts.push(T.trackNo + ' ' + t.track)
    if (t.artist) parts.push(t.artist)
    return parts.join(' - ')
  }

  function songEntry(id, sub) {
    const t = lib.byId[id]
    return { kind: 'song', id: id, label: t.title, sub: sub !== undefined ? sub : songLine(t) }
  }

  export default {
    data: {
      title: '',
      subtitle: '',
      actions: [],
      rows: [],
      emptyText: '',
      hasMore: false,
      moreText: T.more
    },
    view: null,
    entries: [],
    songIds: [],
    shown: STEP,
    editing: false,
    currentId: '',
    unsub: null,
    onInit() {
      this.view = takeView() || { kind: 'all' }
      boot().then(() => this.rebuild())
    },
    onShow() {
      if (!this.unsub) {
        this.unsub = subscribe(() => {
          const t = current()
          const id = t ? t.id : ''
          if (id !== this.currentId) this.render()
        })
      }
      // Favorites, playlists or the queue may have changed on another page.
      if (lib.status !== 'loading') this.rebuild()
    },
    onHide() {
      if (this.unsub) this.unsub()
      this.unsub = null
    },

    // Builds title, actions and the full entry list for the view.
    rebuild() {
      const v = this.view
      let title = ''
      let subtitle = ''
      let actions = []
      let entries = []
      let songIds = []
      let empty = T.noSongs
      const playActions = [{ key: 'playAll', label: T.playAll }, { key: 'shuffle', label: T.shuffleAll }]

      if (v.kind === 'folders') {
        const node = findFolder(v.path || '')
        title = node && node.path ? node.name : T.folders
        if (node) {
          // Breadcrumb of the parent folders, for nested folders only.
          const parts = node.path ? node.path.split('/') : []
          if (parts.length > 1) subtitle = parts.slice(0, -1).join(' / ')
          node.childList.forEach(c => {
            entries.push({ kind: 'folder', path: c.path, label: c.name, sub: countText(folderTracksDeep(c).length) })
          })
          node.tracks.forEach(id => entries.push(songEntry(id)))
          songIds = node.tracks
          if (folderTracksDeep(node).length) {
            actions = [
              { key: 'playDeep', label: node.childList.length ? T.playAllDeep : T.playAll },
              { key: 'shuffleDeep', label: T.shuffleAll }
            ]
          }
        }
      } else if (v.kind === 'artists') {
        title = T.artists
        entries = lib.artists.map(a => ({ kind: 'group', ref: a.name, label: a.name, sub: countText(a.tracks.length) }))
        empty = ''
      } else if (v.kind === 'artist') {
        const a = lib.artistMap[v.name]
        title = v.name
        if (a) {
          songIds = a.tracks
          entries = songIds.map(id => songEntry(id, lib.byId[id].album))
          subtitle = countText(songIds.length)
        }
      } else if (v.kind === 'albums') {
        title = T.albums
        entries = lib.albums.map(al => ({
          kind: 'group', ref: al.name, label: al.name, sub: countText(al.tracks.length) + ' - ' + al.artist,
          thumb: al.cover ? ROOT + al.cover : ''
        }))
        empty = ''
      } else if (v.kind === 'album') {
        const al = lib.albumMap[v.name]
        title = v.name
        if (al) {
          songIds = al.tracks
          subtitle = al.artist
          entries = songIds.map(id => {
            const t = lib.byId[id]
            return songEntry(id, trackLine(t))
          })
        }
      } else if (v.kind === 'playlists') {
        title = T.playlists
        lib.playlists.forEach((p, i) => {
          entries.push({ kind: 'group', ref: { src: 'lib', index: i }, label: p.name, sub: countText(p.tracks.length) })
        })
        st.playlists.forEach((p, i) => {
          entries.push({
            kind: 'group', ref: { src: 'user', index: i }, label: p.name,
            sub: T.myPlaylist + ' - ' + countText(existing(p.tracks).length)
          })
        })
        actions = [{ key: 'newList', label: T.newPlaylist }]
        empty = entries.length ? '' : T.noPlaylists
      } else if (v.kind === 'playlist') {
        const p = v.src === 'user' ? st.playlists[v.index] : lib.playlists[v.index]
        if (p) {
          title = p.name
          songIds = existing(p.tracks)
          entries = songIds.map(id => songEntry(id))
          if (v.src === 'user') {
            actions = this.editing
              ? [{ key: 'edit', label: T.doneEdit }, { key: 'deleteList', label: T.deletePlaylist }]
              : (songIds.length ? playActions : []).concat([{ key: 'edit', label: T.edit }])
            subtitle = this.editing ? T.tapToRemove : countText(songIds.length)
          } else {
            subtitle = countText(songIds.length)
          }
        } else {
          title = T.playlists
        }
      } else if (v.kind === 'recent') {
        title = T.recent
        songIds = existing(st.recent)
        entries = songIds.map(id => songEntry(id))
        empty = T.noRecent
      } else if (v.kind === 'favorites') {
        title = T.favorites
        songIds = existing(st.favorites)
        entries = songIds.map(id => songEntry(id))
        empty = T.noFavorites
      } else if (v.kind === 'queue') {
        title = T.queue
        songIds = queueInOrder()
        entries = songIds.map(id => songEntry(id))
      } else {
        title = T.allSongs
        songIds = lib.tracks.map(t => t.id)
        entries = songIds.map(id => songEntry(id))
        subtitle = countText(songIds.length)
      }

      if (songIds.length && !actions.length && v.kind !== 'queue') actions = playActions
      if (lib.status !== 'ok') {
        actions = []
        entries = []
        empty = lib.status === 'bad' ? T.badIndex : T.empty
      }
      this.title = title
      this.subtitle = subtitle
      this.actions = actions
      this.entries = entries
      this.songIds = songIds
      this.emptyText = entries.length ? '' : empty
      this.render()
    },

    // Turns the first `shown` entries into rows.
    render() {
      const t = current()
      this.currentId = t ? t.id : ''
      const queuePos = this.view.kind === 'queue' ? pl.pos : -1
      const count = Math.min(this.shown, this.entries.length)
      const rows = []
      for (let i = 0; i < count; i++) {
        const e = this.entries[i]
        const isCurrent = e.kind === 'song' && (queuePos >= 0 ? i === queuePos : e.id === this.currentId)
        rows.push({ i: i, kind: e.kind, label: e.label, sub: e.sub || '', thumb: e.thumb || '', current: isCurrent })
      }
      this.rows = rows
      this.hasMore = this.entries.length > count
    },

    showMore() {
      this.shown += STEP
      this.render()
    },

    tap(i) {
      const e = this.entries[i]
      if (!e) return
      const v = this.view
      if (e.kind === 'folder') {
        openView({ kind: 'folders', path: e.path })
        return
      }
      if (e.kind === 'group') {
        if (v.kind === 'artists') openView({ kind: 'artist', name: e.ref })
        else if (v.kind === 'albums') openView({ kind: 'album', name: e.ref })
        else if (v.kind === 'playlists') openView({ kind: 'playlist', src: e.ref.src, index: e.ref.index })
        return
      }
      if (v.kind === 'playlist' && v.src === 'user' && this.editing) {
        removeFromPlaylist(v.index, e.id)
        toast(T.removed)
        this.rebuild()
        return
      }
      if (v.kind === 'queue') {
        jumpTo(i)
        openPlayer()
        return
      }
      const index = this.songIds.indexOf(e.id)
      if (playQueue(this.songIds, index)) openPlayer()
    },

    act(key) {
      const v = this.view
      if (key === 'playAll' || key === 'shuffle') {
        const shuffle = key === 'shuffle'
        if (playQueue(this.songIds, shuffle ? -1 : 0, shuffle)) openPlayer()
      } else if (key === 'playDeep' || key === 'shuffleDeep') {
        const node = findFolder(v.path || '')
        if (!node) return
        const shuffle = key === 'shuffleDeep'
        if (playQueue(folderTracksDeep(node), shuffle ? -1 : 0, shuffle)) openPlayer()
      } else if (key === 'newList') {
        openInput('newlist')
      } else if (key === 'edit') {
        this.editing = !this.editing
        this.rebuild()
      } else if (key === 'deleteList') {
        deletePlaylist(v.index)
        toast(T.removed)
        router.back()
      }
    }
  }
</script>
