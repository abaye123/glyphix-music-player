<template>
  <scroll class="page">
    <div class="top-space"></div>
    <div if="{{!hasTrack}}" class="message-box">
      <image class="cover-note" src="/assets/note.png"/>
      <text class="message">{{noTrackText}}</text>
    </div>
    <div if="{{hasTrack}}" class="column">
      <div class="cover-box">
        <image if="{{coverSrc}}" class="cover" src="{{coverSrc}}"/>
        <image if="{{!coverSrc}}" class="cover-note" src="/assets/note.png"/>
      </div>
      <text class="song-title">{{title}}</text>
      <text class="song-artist">{{artist}}</text>
      <div class="times">
        <text class="time">{{elapsed}}</text>
        <text class="error">{{errorText}}</text>
        <text class="time">{{total}}</text>
      </div>
      <progress class="bar" min="0" max="1000" value="{{progress}}"></progress>
      <div class="transport">
        <div class="side-btn" on:click="prev">
          <image class="side-icon" src="/assets/prev.png"/>
        </div>
        <div class="play-btn" on:click="toggle">
          <image if="{{playing}}" class="play-icon" src="/assets/pause.png"/>
          <image if="{{!playing}}" class="play-icon" src="/assets/play.png"/>
        </div>
        <div class="side-btn" on:click="next">
          <image class="side-icon" src="/assets/next.png"/>
        </div>
      </div>
      <div class="seek-row">
        <div class="seek-btn" on:click="seekBy(-10)">
          <text class="seek-text">-10</text>
        </div>
        <div class="seek-btn" on:click="seekBy(30)">
          <text class="seek-text">+30</text>
        </div>
      </div>

      <div class="modes">
        <div class="mode-btn" on:click="cycleRepeat">
          <image if="{{repeat === 'off'}}" class="mode-icon" src="/assets/repeat-off.png"/>
          <image if="{{repeat === 'all'}}" class="mode-icon" src="/assets/repeat-all.png"/>
          <image if="{{repeat === 'one'}}" class="mode-icon" src="/assets/repeat-one.png"/>
        </div>
        <div class="mode-btn" on:click="toggleShuffle">
          <image if="{{shuffle}}" class="mode-icon" src="/assets/shuffle-on.png"/>
          <image if="{{!shuffle}}" class="mode-icon" src="/assets/shuffle-off.png"/>
        </div>
        <div class="mode-btn" on:click="toggleFavorite">
          <image if="{{favorite}}" class="mode-icon" src="/assets/heart-on.png"/>
          <image if="{{!favorite}}" class="mode-icon" src="/assets/heart-off.png"/>
        </div>
      </div>
      <text class="mode-text">{{modeText}}</text>
      <div class="volume">
        <div class="vol-btn" on:click="volume(-1)">
          <text class="vol-sign">-</text>
        </div>
        <text class="vol-text">{{volumeText}}</text>
        <div class="vol-btn" on:click="volume(1)">
          <text class="vol-sign">+</text>
        </div>
      </div>
      <div class="pill" on:click="addToList">
        <text class="pill-text">{{addText}}</text>
      </div>
      <div class="pill" on:click="openQueue">
        <text class="pill-text">{{queueText}}</text>
      </div>
      <div class="pill" on:click="openArtist">
        <text class="pill-text">{{artistText}}</text>
      </div>
      <div class="pill" on:click="openAlbum">
        <text class="pill-text">{{albumText}}</text>
      </div>
    </div>
    <div class="bottom-space"></div>
  </scroll>
</template>

<style>
  .page {
    width: 466px;
    height: 466px;
    background-color: #000000;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .top-space {
    width: 10px;
    height: 30px;
  }

  .bottom-space {
    width: 10px;
    height: 90px;
  }

  .column {
    width: 466px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .message-box {
    width: 340px;
    margin-top: 100px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .message {
    width: 340px;
    margin-top: 16px;
    font-size: 28px;
    color: #d8d8e8;
    text-align: center;
  }

  .cover-box {
    width: 120px;
    height: 120px;
    border-radius: 16px;
    background-color: #1e1e2c;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cover {
    width: 120px;
    height: 120px;
    border-radius: 16px;
  }

  .cover-note {
    width: 80px;
    height: 80px;
  }

  .song-title {
    width: 330px;
    height: 38px;
    margin-top: 8px;
    font-size: 28px;
    color: #ffffff;
    text-align: center;
    max-lines: 1;
    text-overflow: ellipsis;
  }

  .song-artist {
    width: 300px;
    height: 30px;
    font-size: 22px;
    color: #b0b0c4;
    text-align: center;
    max-lines: 1;
    text-overflow: ellipsis;
  }

  .times {
    width: 330px;
    height: 28px;
    margin-top: 4px;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
  }

  .time {
    font-size: 20px;
    color: #b0b0c4;
  }

  .error {
    font-size: 20px;
    color: #ff6070;
  }

  /* A bound inline width is not re-applied on updates; the progress value is. */
  .bar {
    width: 330px;
    height: 10px;
    margin-top: 2px;
    color: #ffa040;
    background-color: #33334a;
  }

  .transport {
    width: 330px;
    height: 96px;
    margin-top: 10px;
    display: flex;
