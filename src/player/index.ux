    justify-content: space-between;
    align-items: center;
  }

  .side-btn {
    width: 84px;
    height: 84px;
    border-radius: 42px;
    background-color: #1e1e2c;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .side-icon {
    width: 40px;
    height: 40px;
  }

  .play-btn {
    width: 96px;
    height: 96px;
    border-radius: 48px;
    background-color: #ffa040;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .play-icon {
    width: 48px;
    height: 48px;
  }

  .seek-row {
    width: 220px;
    height: 60px;
    margin-top: 8px;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
  }

  .seek-btn {
    width: 100px;
    height: 56px;
    border-radius: 28px;
    background-color: #1e1e2c;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .seek-text {
    font-size: 26px;
    color: #ffffff;
  }

  .modes {
    width: 300px;
    height: 84px;
    margin-top: 70px;
    display: flex;
