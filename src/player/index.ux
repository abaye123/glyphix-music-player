    justify-content: space-between;
    align-items: center;
  }

  .mode-btn {
    width: 80px;
    height: 80px;
    border-radius: 40px;
    background-color: #1e1e2c;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .mode-icon {
    width: 44px;
    height: 44px;
  }

  .mode-text {
    width: 320px;
    height: 32px;
    margin-top: 6px;
    font-size: 22px;
    color: #b0b0c4;
    text-align: center;
  }

  .volume {
    width: 330px;
    height: 84px;
    margin-top: 12px;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
  }

  .vol-btn {
    width: 80px;
    height: 80px;
    border-radius: 40px;
    background-color: #1e1e2c;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .vol-sign {
    font-size: 40px;
    color: #ffffff;
  }

  .vol-text {
    font-size: 24px;
    color: #ffffff;
    text-align: center;
  }

  .pill {
    width: 320px;
    height: 66px;
    margin-top: 10px;
    border-radius: 33px;
    background-color: #1e1e2c;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .pill-text {
    font-size: 26px;
    color: #ffffff;
    text-align: center;
  }
</style>

<script>
  import prompt from '@system.prompt'
  import router from '@system.router'
  import { boot, openView } from '../lib/boot.js'
  import { coverUri } from '../lib/library.js'
  import { st, isFavorite, toggleFavorite } from '../lib/store.js'
  import * as P from '../lib/player.js'
  import { T } from '../lib/strings.js'
  import { formatTime } from '../lib/util.js'

  function toast(text) {
    try {
      prompt.showToast({ message: text })
    } catch (e) {
      console.info('[music] toast failed: ' + e)
    }
  }

  export default {
    data: {
      hasTrack: false,
      noTrackText: T.noTrack,
      coverSrc: '',
      title: '',
      artist: '',
      elapsed: '0:00',
      total: '0:00',
      progress: 0,
      errorText: '',
      playing: false,
      repeat: 'off',
      shuffle: false,
      favorite: false,
      modeText: '',
      volumeText: '',
      addText: T.addToPlaylist,
      queueText: T.queue,
      artistText: T.toArtist,
      albumText: T.toAlbum
    },
    unsub: null,
    onInit() {
      boot().then(() => this.refresh())
    },
    onShow() {
      if (!this.unsub) this.unsub = P.subscribe(() => this.refresh())
      P.sync()
      this.refresh()
      this.readVolume()
    },
    onHide() {
      if (this.unsub) this.unsub()
      this.unsub = null
    },
    refresh() {
      const t = P.current()
      this.hasTrack = !!t
      if (!t) return
      const cover = coverUri(t)
      if (this.coverSrc !== cover) this.coverSrc = cover
      this.title = t.title
      this.artist = t.artist || T.unknownArtist
      const d = P.pl.duration > 0 ? P.pl.duration : t.duration
      const pos = Math.min(P.pl.position, d > 0 ? d : P.pl.position)
      this.elapsed = formatTime(pos)
      this.total = formatTime(d)
      this.progress = d > 0 ? Math.round(1000 * pos / d) : 0
      this.errorText = P.pl.error ? T.playError : ''
      this.playing = P.pl.status === 'play'
      this.repeat = st.repeat
      this.shuffle = st.shuffle
      this.favorite = isFavorite(t.id)
      this.modeText = this.modeLine()
    },
    modeLine() {
      const r = st.repeat === 'all' ? T.repeatAll : st.repeat === 'one' ? T.repeatOne : T.repeatOff
      return r + ' | ' + (st.shuffle ? T.shuffleOn : T.shuffleOff)
    },
    readVolume() {
      P.getVolumeStep().then(step => this.showVolume(step))
    },
    showVolume(step) {
      this.volumeText = step < 0 ? T.volume : T.volume + ' ' + step + '/' + P.VOLUME_MAX
    },
    toggle() {
      P.toggle()
      this.refresh()
    },
    prev() {
      P.prev()
    },
    next() {
      P.next()
    },
    seekBy(delta) {
      P.seekBy(delta)
    },
    cycleRepeat() {
      P.cycleRepeat()
      this.refresh()
    },
    toggleShuffle() {
      P.setShuffle(!st.shuffle)
      this.refresh()
    },
    toggleFavorite() {
      const t = P.current()
      if (!t) return
      const on = toggleFavorite(t.id)
      toast(on ? T.favOn : T.favOff)
      this.refresh()
    },
    volume(direction) {
      P.stepVolume(direction).then(step => this.showVolume(step))
    },
    addToList() {
      if (!P.current()) return
      router.push({ uri: 'addto' })
    },
    openQueue() {
      openView({ kind: 'queue' })
    },
    openArtist() {
      const t = P.current()
      if (t) openView({ kind: 'artist', name: t.artist || T.unknownArtist })
    },
    openAlbum() {
      const t = P.current()
      if (t) openView({ kind: 'album', name: t.album || T.unknownAlbum })
    }
  }
</script>
