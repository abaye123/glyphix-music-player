<template>
  <scroll class="page">
    <div class="top-space"></div>
    <div class="field">
      <text if="{{query}}" class="query">{{query}}</text>
      <text if="{{!query}}" class="hint">{{hint}}</text>
    </div>
    <div for="r in keyRows" class="key-row">
      <div for="k in r.keys" class="key" on:click="press(k)">
        <text class="key-text">{{k}}</text>
      </div>
    </div>
    <div class="key-row">
      <div class="wide-key" on:click="backspace">
        <text class="wide-text">{{backText}}</text>
      </div>
      <div class="wide-key" on:click="clear">
        <text class="wide-text">{{clearText}}</text>
      </div>
      <div class="wide-key" on:click="press(' ')">
        <text class="wide-text">{{spaceText}}</text>
      </div>
      <div class="wide-key toggle-key" on:click="switchLayout">
        <text class="wide-text">{{toggleText}}</text>
      </div>
    </div>
    <div if="{{mode === 'newlist'}}" class="save" on:click="saveList">
      <text class="save-text">{{saveText}}</text>
    </div>
    <text if="{{mode === 'search' && countText}}" class="count">{{countText}}</text>
    <div for="row in results" class="slot">
      <div class="row" on:click="tap(row.i)">
        <div class="texts">
          <text class="label">{{row.label}}</text>
          <text class="sub">{{row.sub}}</text>
        </div>
        <image class="icon" src="/assets/note-small.png"/>
      </div>
    </div>
    <div class="bottom-space"></div>
  </scroll>
</template>

<style>
  .page {
    width: 466px;
    height: 466px;
    background-color: #000000;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .top-space {
    width: 10px;
    height: 44px;
  }

  .bottom-space {
    width: 10px;
    height: 100px;
  }

  .field {
    width: 260px;
    height: 56px;
    margin-bottom: 8px;
    border-radius: 28px;
    background-color: #1e1e2c;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 16px;
  }

  .query {
    width: 228px;
    font-size: 26px;
    color: #ffffff;
    text-align: center;
    max-lines: 1;
    text-overflow: ellipsis;
  }

  .hint {
    width: 228px;
    font-size: 24px;
    color: #707088;
    text-align: center;
  }

  .key-row {
    height: 58px;
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
  }

  .key {
    width: 46px;
    height: 52px;
    margin: 0 3px;
    border-radius: 12px;
    background-color: #26263a;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .key-text {
    font-size: 28px;
    color: #ffffff;
  }

  .wide-key {
    width: 74px;
    height: 52px;
    margin: 0 3px;
    border-radius: 14px;
    background-color: #33334a;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .toggle-key {
    background-color: #3a2410;
  }

  .wide-text {
    font-size: 20px;
    color: #ffffff;
  }

  .save {
    width: 240px;
    height: 62px;
    margin-top: 12px;
    border-radius: 31px;
    background-color: #ffa040;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .save-text {
    font-size: 26px;
    color: #141420;
  }

  .count {
    width: 300px;
    margin-top: 10px;
    font-size: 22px;
    color: #ffa040;
    text-align: center;
  }

  .slot {
    width: 370px;
    height: 84px;
    margin-top: 8px;
  }

  .row {
    width: 370px;
    height: 84px;
    border-radius: 20px;
    background-color: #16161f;
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 0 14px;
  }

  .texts {
    flex: 1;
    height: 84px;
    margin-right: 10px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-end;
  }

  .label {
    max-width: 280px;
    font-size: 26px;
    color: #ffffff;
    max-lines: 1;
    text-overflow: ellipsis;
  }

  .sub {
    max-width: 280px;
    font-size: 19px;
    color: #9a9ab0;
    max-lines: 1;
    text-overflow: ellipsis;
  }

  .icon {
    width: 40px;
    height: 40px;
  }
</style>

<script>
  import prompt from '@system.prompt'
  import router from '@system.router'
  import { boot, takeInput, openPlayer, markAdded } from '../lib/boot.js'
  import { lib, searchTracks, songLine } from '../lib/library.js'
  import { createPlaylist, addToPlaylist } from '../lib/store.js'
  import { playQueue } from '../lib/player.js'
  import { T } from '../lib/strings.js'

  const MAX_LEN = 30
  const MAX_RESULTS = 30

  // Hebrew rows are listed right to left and reversed for the left-to-right flex row.
  const LAYOUTS = {
    he: [
      ['א', 'ב', 'ג', 'ד', 'ה', 'ו', 'ז'],
      ['ח', 'ט', 'י', 'כ', 'ך', 'ל', 'מ'],
      ['ם', 'נ', 'ן', 'ס', 'ע', 'פ', 'ף'],
      ['צ', 'ץ', 'ק', 'ר', 'ש', 'ת']
    ],
    en: [
      ['a', 'b', 'c', 'd', 'e', 'f', 'g'],
      ['h', 'i', 'j', 'k', 'l', 'm', 'n'],
      ['o', 'p', 'q', 'r', 's', 't', 'u'],
      ['v', 'w', 'x', 'y', 'z']
    ],
    num: [
      ['1', '2', '3', '4', '5'],
      ['6', '7', '8', '9', '0']
    ]
  }
  const NEXT_LAYOUT = { he: 'en', en: 'num', num: 'he' }
  const TOGGLE_LABEL = { he: 'ABC', en: '123', num: 'אבג' }

  function rowsFor(name) {
    return LAYOUTS[name].map(keys => ({ keys: name === 'he' ? keys.slice().reverse() : keys }))
  }

  function toast(text) {
    try {
      prompt.showToast({ message: text })
    } catch (e) {
      console.info('[music] toast failed: ' + e)
    }
  }

  export default {
    data: {
      mode: 'search',
      query: '',
      hint: T.searchHint,
      layout: 'he',
      keyRows: rowsFor('he'),
      toggleText: TOGGLE_LABEL.he,
      backText: T.backspace,
      clearText: T.clear,
      spaceText: T.space,
      saveText: T.save,
      countText: '',
      results: []
    },
    resultIds: [],
    extra: null,
    onInit() {
      const input = takeInput()
      this.mode = input.mode
      this.extra = input.extra
      this.hint = this.mode === 'newlist' ? T.playlistName : T.searchHint
      boot()
    },
    press(ch) {
      if (this.query.length >= MAX_LEN) return
      if (ch === ' ' && (!this.query || this.query.charAt(this.query.length - 1) === ' ')) return
      this.query = this.query + ch
      this.update()
    },
    backspace() {
      if (!this.query) return
      this.query = this.query.slice(0, -1)
      this.update()
    },
    clear() {
      this.query = ''
      this.update()
    },
    switchLayout() {
      this.layout = NEXT_LAYOUT[this.layout]
      this.keyRows = rowsFor(this.layout)
      this.toggleText = TOGGLE_LABEL[this.layout]
    },
    update() {
      if (this.mode !== 'search') return
      const q = this.query.trim()
      if (!q || lib.status !== 'ok') {
        this.resultIds = []
        this.results = []
        this.countText = ''
        return
      }
      const ids = searchTracks(q)
      this.resultIds = ids
      this.countText = ids.length ? T.results + ': ' + ids.length : T.noResults
      this.results = ids.slice(0, MAX_RESULTS).map((id, i) => {
        const t = lib.byId[id]
        const sub = songLine(t)
        return { i: i, label: t.title, sub: sub || t.folder }
      })
    },
    tap(i) {
      if (playQueue(this.resultIds, i)) openPlayer()
    },
    saveList() {
      const name = this.query.trim()
      if (!name) {
        toast(T.needName)
        return
      }
      const index = createPlaylist(name)
      // Opened from "add to playlist": put the song straight into the new list.
      if (this.extra && this.extra.addId) {
        addToPlaylist(index, this.extra.addId)
        toast(T.added)
        markAdded()
      }
      router.back()
    }
  }
</script>
